# Contoh env untuk docker-compose.staging.yml.
# Copy jadi `.env` di direktori yang sama (Docker Compose otomatis membacanya),
# atau isikan sebagai Environment variables di stack Portainer.
# JANGAN commit file `.env` yang berisi secret asli — sudah di-ignore lewat .gitignore.

POSTGRES_DB=siakad
POSTGRES_USER=siakad
DB_PASSWORD=ganti-dengan-password-kuat

SERVER_PORT=8080

# Base64, minimal 32 bytes, generate mis. dengan: openssl rand -base64 32
JWT_SECRET=ganti-dengan-secret-base64-minimal-32-bytes
